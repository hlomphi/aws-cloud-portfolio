digraph Architecture {
 graph [rankdir=TB, bgcolor="#ffffff", fontname="DejaVu Sans", fontsize=22, fontcolor="#142c49", labelloc=t, pad=0.35, nodesep=0.35, ranksep=0.58, compound=true, label="E-commerce infrastructure"];
 node [shape=box, style="rounded,filled", fillcolor="#edf4ff", color="#6183aa", fontcolor="#142c49", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.10"];
 edge [color="#456786", fontcolor="#314d6c", fontname="DejaVu Sans", fontsize=10, arrowsize=0.7];

subgraph cluster_legacy {
 label="LEGACY | Operated 2024–2026";
 old [label="Users / DNS"]; legacy [label="Amazon Lightsail
PHP + MySQL"]; backup [label="Lightsail backups"];
 old -> legacy [label="HTTPS"]; legacy -> backup [label="backup / restore",dir=both];
}
subgraph cluster_modern {
 label="MODERNISED | Staging deployed / Production access restricted";
 ingress [label="Permitted traffic"]; ecr [label="Amazon ECR"]; sec [label="Production monitoring
GuardDuty / Security Hub / AWS Config"];
 subgraph cluster_vpc {
  label="Amazon VPC";
  alb [label="Load balancer"]; ecs [label="ECS Fargate"]; rds [label="RDS PostgreSQL",fillcolor="#e1f6ee"];
  alb -> ecs -> rds;
 }
 ingress -> alb [label="HTTPS"]; ecr -> ecs [label="container image"]; ecs -> sec [label="monitoring",style=dashed];
}
}
